{
  "name": "lobe-mygo-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/build-wasm.ts && bun run --parallel dev:wasm dev:docs",
    "dev:wasm": "bun scripts/build-wasm.ts --watch",
    "dev:docs": "lobedocs dev",
    "build": "bun scripts/build-wasm.ts --prod && lobedocs build",
    "gen:tokens": "bun scripts/gen-tokens.ts",
    "postinstall": "lobedocs typegen"
  },
  "devDependencies": {
    "@lobehub/docs-kit": "6.3.1",
    "@lobehub/ui": "6.15.2",
    "@react-router/dev": "8.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "lucide-react": "^1.55.0",
    "lucide-static": "^1.70.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.3.4"
  }
}
